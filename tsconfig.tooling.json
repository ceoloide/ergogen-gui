{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "*.config.mts",
    "src/ergogen.d.ts"
  ]
}
