{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/service-worker.ts",
    "**/*.test.{ts,tsx}",
    "src/workers/*.worker.{ts,tsx}",
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // Native release binary installed separately from the Node dependency graph.
  "ignoreBinaries": ["actionlint", "shellcheck", "zizmor"],
  "ignoreDependencies": [
    "@jscad/csg",
    "@jscad/stl-serializer",
    "@testing-library/user-event",
    "@types/styled-components",
    "@typescript-eslint/parser",
    "baseline-browser-mapping",
    "eslint-plugin-prettier",
    "markdownlint",
  ],
}
