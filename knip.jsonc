{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/service-worker.ts",
    "**/*.test.{ts,tsx}",
    "src/workers/*.worker.{ts,tsx}",
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // Native release binary installed separately from the Node dependency graph.
  "ignoreBinaries": ["actionlint", "shellcheck", "zizmor"],
  // vite build loads this package through Babel and browserslist, and the app
  // never imports it. It is declared so that Dependabot, which updates only
  // declared packages, keeps the browser data that browserslist reads current.
  "ignoreDependencies": ["baseline-browser-mapping"],
}
