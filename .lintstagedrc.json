{
  "src/**/*.{ts,tsx}": [
    "eslint --fix",
    "prettier --write",
    "vitest related --run --passWithNoTests"
  ],
  "e2e/**/*.ts": ["eslint --fix", "prettier --write"],
  "tests/**/*.ts": ["eslint --fix", "prettier --write"],
  ".github/workflows/*.{yml,yaml}": [
    "prettier --write",
    "actionlint -shellcheck=shellcheck -pyflakes=",
    "zizmor --offline",
    "vitest run tests/workflow-security.test.ts"
  ],
  "patch/**/*.{ts,tsx,js,jsx}": ["prettier --write"],
  "**/*.md": ["markdownlint --fix", "prettier --write"],
  "scripts/**/*.{js,mjs}": ["eslint --fix", "prettier --write"],
  "**/*.sh": ["shellcheck"],
  "./*.{js,mjs,ts,mts}": ["eslint --fix", "prettier --write"],
  ".github/dependabot.yml": ["prettier --write", "zizmor --offline"],
  ".github/actionlint.yaml": ["prettier --write"],
  "**/*.{json,jsonc}": ["prettier --write"]
}
