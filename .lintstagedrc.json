{
  "**/*.md": ["markdownlint --fix"],
  "*": [
    "eslint --fix --max-warnings 0 --no-warn-ignored",
    "prettier --write --ignore-unknown"
  ],
  "src/**/*.{ts,tsx}": ["vitest related --run --passWithNoTests"],
  ".github/workflows/*.{yml,yaml}": [
    "actionlint -shellcheck=shellcheck -pyflakes=",
    "zizmor --offline",
    "vitest run tests/workflow-security.test.ts"
  ],
  ".github/dependabot.yml": ["zizmor --offline"],
  "**/*.sh": ["shellcheck"],
  ".husky/pre-commit": ["shellcheck"]
}
